{
    
    "version": "0.2.0",
    "configurations": [


        {
            "name": "Main", 
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/main", //path to your programs exe and exe name
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}